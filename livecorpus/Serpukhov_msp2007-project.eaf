        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1054"
                TIME_SLOT_REF1="ts79" TIME_SLOT_REF2="ts81">
                <ANNOTATION_VALUE>я указала X, так как по следующему слову нельзя установить часть речи, но это возможно это CONJ</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1056"
                TIME_SLOT_REF1="ts175" TIME_SLOT_REF2="ts177">
                <ANNOTATION_VALUE>я думаю, что это относительное местоимение, поэтому указала PRON</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1847"
                TIME_SLOT_REF1="ts325" TIME_SLOT_REF2="ts327">
                <ANNOTATION_VALUE>я решила, что как-то - один токен, потому что если то убрать, то поменяется смысл</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1858"
                TIME_SLOT_REF1="ts373" TIME_SLOT_REF2="ts375">
                <ANNOTATION_VALUE>мне кажется, это союзное слово, поэтому я указала CONJ (наречие)</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1985"
                TIME_SLOT_REF1="ts599" TIME_SLOT_REF2="ts600">
                <ANNOTATION_VALUE>сомневалась между частицей и предикативом, выбрала предикатив, потому что показалось, что нет - сказуемое в безличном придаточном предложении</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2121"
                TIME_SLOT_REF1="ts925" TIME_SLOT_REF2="ts931">
                <ANNOTATION_VALUE>я решила,что это числительное, потому что это понятно из следующего слова</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2266"
                TIME_SLOT_REF1="ts1089" TIME_SLOT_REF2="ts1091">
                <ANNOTATION_VALUE>по аналогии с "в общем"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>

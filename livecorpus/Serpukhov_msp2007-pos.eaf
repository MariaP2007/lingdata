    <TIER ANNOTATOR="MariaP2007" DEFAULT_LOCALE="ru"
        LINGUISTIC_TYPE_REF="utterance" TIER_ID="comment">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1055"
                TIME_SLOT_REF1="ts44" TIME_SLOT_REF2="ts47">
                <ANNOTATION_VALUE>целиком это порядковое числительное, поэтому каждое слово я отметила как ANUM</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1054"
                TIME_SLOT_REF1="ts50" TIME_SLOT_REF2="ts52">
                <ANNOTATION_VALUE>я указала X, так как по следующему слову нельзя установить часть речи, но это возможно это CONJ</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1056"
                TIME_SLOT_REF1="ts101" TIME_SLOT_REF2="ts103">
                <ANNOTATION_VALUE>я думаю, что это относительное местоимение, поэтому указала PRON</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
